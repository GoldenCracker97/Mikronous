# Installed to ~/.config/mikronous/llama.env by scripts/install.sh.
# Rewritten by `mik model` to fit your hardware. Hand-edit freely; then:
#   systemctl --user restart mikronous-llama

LLAMA_SERVER=/home/USER/.local/share/mikronous/llama.cpp/bin/llama-server
LLAMA_PORT=8081
LLAMA_MODEL=/home/USER/.hermes/models/Qwen3-4B-Instruct-2507-Q4_K_M.gguf
LLAMA_ALIAS=mikronous-local

# Hermes needs >= 64k context for multi-step tool use.
LLAMA_CTX=65536
# Layers on the GPU (999 = all). Lower this if the model does not fit.
LLAMA_NGL=999
LLAMA_THREADS=8
# KV cache quantisation: q8_0 keys / q4_0 values is the 8 GB VRAM compromise.
# f16/f16 is best quality (needs ~2x the memory), q4_0/q4_0 is smallest.
LLAMA_KV_K=q8_0
LLAMA_KV_V=q4_0
LLAMA_PARALLEL=1
LLAMA_EXTRA_ARGS=
