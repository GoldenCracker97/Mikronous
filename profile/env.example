# Copied by scripts/install.sh to ~/.hermes/profiles/mikronous/.env (API_SERVER_KEY is generated).

# Hermes API server: the tray app talks to this.
API_SERVER_ENABLED=true
API_SERVER_KEY=replace-me
API_SERVER_HOST=127.0.0.1
API_SERVER_PORT=8643   # 8642 is the default profile's gateway; keep ours apart
API_SERVER_MODEL_NAME=mikronous

# Mikronous plugin.
# Delivery target for `deliver=mikronous` cron jobs (any label; there is one desktop).
MIKRONOUS_HOME_CHANNEL=desktop
# Colon-separated folders indexed by docs_search.
MIKRONOUS_DOCS_DIRS=~/Documents

# Optional integrations. Keys you add here are used only when you ask for that service and are sent
# only to the host you name; nothing is enrolled automatically. `mik privacy status` lists them.
# Home Assistant (built-in Hermes tools activate when HASS_TOKEN is set):
#HASS_URL=http://homeassistant.local:8123
#HASS_TOKEN=
# Any API for the http_request tool, referenced by name (auth_env=GITHUB_TOKEN):
#GITHUB_TOKEN=
