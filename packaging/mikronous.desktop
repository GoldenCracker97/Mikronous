[Desktop Entry]
Type=Application
Name=Mikronous
GenericName=Desktop assistant
Comment=Local AI assistant: show or hide the chat window
Exec=mik toggle
Icon=mikronous
Terminal=false
Categories=Utility;
StartupNotify=false
X-KDE-Shortcuts=Meta+Space
Actions=selection;vox;screen;

[Desktop Action selection]
Name=Mikronous: act on selected text
Exec=mik selection
Icon=mikronous
X-KDE-Shortcuts=Meta+Shift+Space

[Desktop Action vox]
Name=Mikronous: voice input
Exec=mik vox
Icon=mikronous
X-KDE-Shortcuts=Meta+Shift+V

[Desktop Action screen]
Name=Mikronous: ask about the screen
Exec=mik screen
Icon=mikronous
X-KDE-Shortcuts=Meta+Shift+S
